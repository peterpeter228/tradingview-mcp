# CoinGlass Legend MCP Server - LLM Configuration
# 
# 文件位置: /etc/coinglass-legend-mcp/llm.env
#
# 使用 CometAPI (OpenAI-compatible) 进行图表分析
# 获取 API Key: https://api.cometapi.com/

# LLM API Key (必需)
LLM_API_KEY=sk-your-cometapi-key-here

# LLM API Base URL (CometAPI)
LLM_API_BASE=https://api.cometapi.com/v1

# 模型名称 (支持视觉能力的模型)
LLM_MODEL=openai/gpt-5.2

# LLM 请求超时时间 (秒)
LLM_TIMEOUT_S=120

# ============================================
# 可选配置 (可在 systemd unit 中覆盖)
# ============================================

# 浏览器视口尺寸
# VIEWPORT_W=2560
# VIEWPORT_H=1440

# 图表稳定等待时间 (毫秒)
# STABILIZE_WAIT_MS=1200

# 是否隐藏 UI 遮挡元素
# HIDE_UI=true

# 账号配置文件路径 (建议在 systemd 中设置)
# ACCOUNTS_YAML=/etc/coinglass-legend-mcp/accounts.yaml
