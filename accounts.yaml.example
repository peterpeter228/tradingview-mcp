# ===========================================
# TradingView Multi-Account Configuration
# ===========================================
# 
# How to get TradingView session cookies:
# 1. Log into TradingView in your browser
# 2. Open Developer Tools (F12)
# 3. Go to Application/Storage > Cookies > https://www.tradingview.com
# 4. Copy the values of 'sessionid' and 'sessionid_sign' cookies
#
# Note: Each account will be used to capture and analyze charts sequentially.
# The analysis results from all accounts will be returned together.

tradingview_accounts:
  - name: account1
    session: your_sessionid_cookie_value_here
    sign: your_sessionid_sign_cookie_value_here

  - name: account2
    session: your_second_sessionid_cookie_value_here
    sign: your_second_sessionid_sign_cookie_value_here

# Add more accounts as needed:
#  - name: account3
#    session: xxx
#    sign: v3:xxx
